# Copy to .env and fill in. Never commit .env.

# Domain the site runs on; its DNS A record must point to this server.
DOMAIN=reflect.example.kz

# Database password (any long random string): openssl rand -hex 24
POSTGRES_PASSWORD=

# Encrypts Kaspi / MoySklad / MCP tokens. When moving from Replit, use the SAME value as there,
# otherwise sellers must re-enter their tokens. New install: openssl rand -hex 32
ENCRYPTION_KEY=
# During a key change: previous value(s), comma-separated.
# ENCRYPTION_KEY_PREVIOUS=

# Optional: model answers in "Ask Reflect" and review themes. Without it, rule-based answers.
ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-sonnet-5-5

# Optional
# LOG_LEVEL=info
# BACKUP_KEEP_DAYS=14
# BACKUP_KEEP_SAFETY_DAYS=60

# Optional: copy the backups to storage outside this server (DEPLOY.md, section 13). Off until BACKUP_REMOTE is set.
# BACKUP_REMOTE=offsite:bucket-name/reflect
# BACKUP_OFFSITE_EVERY_HOURS=6
# BACKUP_REMOTE_KEEP_DAYS=60
# S3-compatible storage:
# RCLONE_CONFIG_OFFSITE_TYPE=s3
# RCLONE_CONFIG_OFFSITE_PROVIDER=Other
# RCLONE_CONFIG_OFFSITE_ENDPOINT=https://s3.example.kz
# RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
# RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
# Or another server over SFTP (the password must be obscured: docker run --rm rclone/rclone obscure 'password'):
# RCLONE_CONFIG_OFFSITE_TYPE=sftp
# RCLONE_CONFIG_OFFSITE_HOST=backup.example.kz
# RCLONE_CONFIG_OFFSITE_USER=reflect
# RCLONE_CONFIG_OFFSITE_PASS=
# ALLOWED_ORIGINS=
